# lead-bot/deploy/client.env.template
# A new client's .env, made by new-client.sh. Lines that still say CHANGE_ME must be filled in
# before update.sh will start the client. The names are the ones the code reads (grep environ in
# src/): a variable that isn't listed here does nothing.
#
# Never commit this file once it holds real values, and never paste its contents into a chat or a
# ticket. It is backed up, encrypted, by deploy/backup.sh.

# --- the business -----------------------------------------------------------------------------
# The REGISTERED business name: it starts the first text to every lead and is in the consent wording.
BUSINESS_NAME=CHANGE_ME
# A number people can phone, 10 digits (not the texting number).
BUSINESS_CALLBACK_PHONE=CHANGE_ME
BUSINESS_TIMEZONE=America/Phoenix
# Where Twilio and the form reach this client. Filled in for you; it must match the Caddy host.
PUBLIC_BASE_URL=@PUBLIC_BASE_URL@

# --- the models --------------------------------------------------------------------------------
TYPESAFE_API_KEY=CHANGE_ME
OPENAI_API_KEY=CHANGE_ME
# Optional: WRITER_MODEL=

# --- Twilio (the client's own subaccount) -----------------------------------------------------
TWILIO_ACCOUNT_SID=CHANGE_ME
TWILIO_AUTH_TOKEN=CHANGE_ME
# The texting number, E.164 (+1...).
TWILIO_PHONE_NUMBER=CHANGE_ME

# --- alerts and reports to the owner (the worker refuses --send without these) ---------------
OWNER_ALERT_EMAIL=CHANGE_ME
SMTP_USERNAME=CHANGE_ME
SMTP_PASSWORD=CHANGE_ME
# Optional: SMTP_HOST=  SMTP_PORT=
# Optional: OWNER_ALERT_PHONE= (E.164) adds a text for alerts that need action today.

# --- calendar -----------------------------------------------------------------------------------
# Optional: GOOGLE_CALENDAR_ID= (default: primary)
# The calendar sign-in is still the 7-day OAuth one; production needs the service account (launch
# plan step 12) before the first paying client.
