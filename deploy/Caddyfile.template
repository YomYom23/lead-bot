# lead-bot/deploy/Caddyfile.template
# One client's site. new-client.sh fills in two placeholders (written below as at-sign words, in
# the two lines that use them) and writes the result to /srv/lead-bot/caddy/sites/<client>.caddy,
# which the main Caddyfile imports. The first placeholder is the client's short name (the same as
# CLIENT in compose.template.yaml); the second is the public host name, e.g. acme.bot.example.com.
# Caddy fetches and renews that host's TLS certificate by itself. A local test uses
# http://acme.localhost:80 as the host, which turns HTTPS off. Keep the placeholder spelling out
# of these comments: the substitution would rewrite them too.
@SITE_ADDRESS@ {
	# reverse_proxy carries the call-relay WebSocket (/calls/relay) with no extra settings, and
	# sets X-Forwarded-For to the visitor's address, which the consent record keeps.
	reverse_proxy lead-bot-@CLIENT@-server:8000
}
