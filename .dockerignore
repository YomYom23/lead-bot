# lead-bot/.dockerignore
# What never goes into the image. The Dockerfile copies only pyproject.toml, uv.lock and src/, so
# this is the second lock on the same door: a later `COPY . .` can't leak a secret.

# Secrets and per-client files (mounted at run time instead)
.env
.env.*
client.toml
client_secret*.json
google_token.json
*service-account*.json

# Data
*.db
*.db-wal
*.db-shm
*.jsonl

# Plans, reports, tests and local tooling
docs/
scenarios/
tests/
.git
.gitignore
.gitattributes
.idea/
.venv/
__pycache__/
*.pyc
.mypy_cache/
.pytest_cache/
.ruff_cache/
